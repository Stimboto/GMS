# SQL Server Configuration
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
ACCEPT_EULA=Y
MSSQL_PID=Developer

# API Configuration
ConnectionStrings__DefaultConnection=Server=gms-sqlserver;Database=GMS_Db;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;
JwtSettings__Key=<YOUR_JWT_SECRET_KEY_HERE>
JwtSettings__Issuer=GMS_Issuer
JwtSettings__Audience=GMS_Audience

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Ollama AI Configuration (Optional)
AI__BaseUrl=http://gms-ollama:11434
AI__Model=llama3.2:1b
AI__TimeoutSeconds=30
